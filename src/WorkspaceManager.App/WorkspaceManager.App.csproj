<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>0.1.4</Version>
    <Product>Desktop Workspace Manager</Product>
    <Title>Desktop Workspace Manager</Title>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../WorkspaceManager.Windows/WorkspaceManager.Windows.csproj" />
    <Content Update="Assets/app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged WinUI currently omits application PRI/XBF from dotnet publish.
       Include generated resources explicitly: microsoft/WindowsAppSDK#6720. -->
  <Target Name="PublishCompiledWinUIResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="The application PRI resource index was not generated." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_CompiledXamlForPublish Include="$(TargetDir)**\*.xbf" Exclude="$(TargetDir)publish\**" />
      <ResolvedFileToPublish Include="@(_CompiledXamlForPublish)">
        <RelativePath>%(_CompiledXamlForPublish.RecursiveDir)%(_CompiledXamlForPublish.Filename)%(_CompiledXamlForPublish.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
